# Copy this file to .env and fill in the mailbox password.
# Inquiries are delivered to INQUIRY_TO_EMAIL.
#
# Google Workspace:  SMTP_HOST=smtp.gmail.com       (use an app password)
# Microsoft 365:     SMTP_HOST=smtp.office365.com
# Typical cPanel:    SMTP_HOST=mail.jdlumen.com

INQUIRY_TO_EMAIL=Info@jdlumen.ai
SMTP_FROM=Info@jdlumen.ai
SMTP_USERNAME=Info@jdlumen.ai
SMTP_HOST=
SMTP_PORT=587
SMTP_PASSWORD=
SMTP_USE_TLS=true

# First team login. Used only when that admin does not exist yet.
ADMIN_EMAIL=admin@jdlumen.com
ADMIN_NAME=JD Lumen Team
ADMIN_PASSWORD=

# Juno. Leave the key empty until the team has one.
# JUNO_PROVIDER is openai or gemini.
# OpenAI model example: gpt-4o-mini
# Gemini model example: gemini-2.0-flash
JUNO_PROVIDER=
JUNO_API_KEY=
JUNO_MODEL=
